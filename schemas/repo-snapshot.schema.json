{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaibuzz0.github.io/Git-hub-command-site/schemas/repo-snapshot.schema.json",
  "title": "GitHub Command Site repository snapshot",
  "type": "object",
  "required": ["schema_version", "generated_at", "source_commit", "repo"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string"},
    "source_commit": {"type": "string", "minLength": 7},
    "repo": {
      "type": "object",
      "required": ["id", "full_name", "url", "default_branch"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "full_name": {"type": "string", "minLength": 3},
        "url": {"type": "string", "pattern": "^https://"},
        "default_branch": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "visibility": {"type": "string"},
        "pages_url": {"type": "string", "pattern": "^https://"}
      },
      "additionalProperties": true
    },
    "stats": {"type": "object"},
    "tools": {"type": "array", "items": {"type": "object"}},
    "toolsets": {"type": "array", "items": {"type": "object"}},
    "cases": {"type": "array", "items": {"type": "object"}},
    "opportunities": {"type": "array", "items": {"type": "object"}},
    "intelligence": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array", "items": {"type": "object"}},
    "prompts": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "agent_ops": {"type": "object"},
    "activity": {"type": "array", "items": {"type": "object"}},
    "links": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
